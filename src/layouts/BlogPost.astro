---
const { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{frontmatter.title} — Dinfo</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <a class="logo" href="/">&gt;_D</a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/blog">Articles</a>
        <a href="/about">About</a>
      </div>
    </nav>
    <main>
      <article>
        <header>
          <span class="tag">{frontmatter.tag}</span>
          <h1>{frontmatter.title}</h1>
          <p class="description">{frontmatter.description}</p>
          <span class="date">{frontmatter.date}</span>
        </header>
        <div class="content">
          <slot />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background-color: #F1E8C7; color: #2d2d2d; font-family: 'Inter', sans-serif; }
  nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 3rem; border-bottom: 1px solid #9CA76440; }
  .logo { font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 700; color: #9CA764; text-decoration: none; }
  .nav-links a { margin-left: 2rem; text-decoration: none; color: #2d2d2d; font-size: 0.95rem; }
  .nav-links a:hover { color: #9CA764; }

  article { max-width: 700px; margin: 5rem auto; padding: 0 2rem; }

  header { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #9CA76440; }
  .tag { font-size: 0.75rem; color: #9CA764; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; }
  h1 { font-family: 'Playfair Display', serif; font-size: 2.8rem; line-height: 1.2; margin: 0.75rem 0 1rem; }
  .description { font-size: 1.1rem; color: #666; line-height: 1.6; margin-bottom: 1rem; }
  .date { font-size: 0.8rem; color: #999; }

  .content { line-height: 1.8; font-size: 1.05rem; }
  .content h2 { font-family: 'Playfair Display', serif; font-size: 1.6rem; margin: 2.5rem 0 1rem; color: #2d2d2d; }
  .content p { margin-bottom: 1.5rem; color: #444; }
  .content ul { margin: 0 0 1.5rem 1.5rem; }
  .content li { margin-bottom: 0.5rem; color: #444; }
  .content strong { color: #2d2d2d; font-weight: 500; }
  .content em { color: #9CA764; font-style: italic; }
</style>