<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background-color: #F1E8C7;
    color: #2d2d2d;
    font-family: 'Inter', sans-serif;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem;
    border-bottom: 1px solid #9CA76440;
  }

  .logo {
    font-family: 'Courier New', monospace;
    font-size: 1.4rem;
    font-weight: 700;
    color: #9CA764;
  }

  .nav-links a {
    margin-left: 2rem;
    text-decoration: none;
    color: #2d2d2d;
    font-size: 0.95rem;
  }

  .nav-links a:hover { color: #9CA764; }

  .hero {
    max-width: 700px;
    margin: 8rem auto;
    padding: 0 2rem;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 4rem;
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

  em { color: #9CA764; font-style: normal; }

  p {
    font-size: 1.1rem;
    color: #555;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: #9CA764;
    color: #F1E8C7;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .btn:hover { background: #8a9558; }
  @media (max-width: 768px) {
  nav {
    padding: 1rem 1.25rem;
  }
  .nav-links a {
    margin-left: 1rem;
    font-size: 0.85rem;
  }
  .hero, .about, .blog-list {
    margin: 4rem auto;
    padding: 0 1.25rem;
  }
  h1 {
    font-size: 2.2rem;
  }
  article {
    margin: 3rem auto;
    padding: 0 1.25rem;
  }
}
