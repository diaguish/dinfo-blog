---
const modules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(modules);
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Articles — Dinfo</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <a class="logo" href="/">&gt;_D</a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/blog">Articles</a>
        <a href="/about">About</a>
      </div>
    </nav>
    <main>
      <section class="blog-list">
        <h1>Articles</h1>
        {posts.map((post) => (
          <a href={post.url} class="post-card">
            <span class="tag">{post.frontmatter.tag}</span>
            <h2>{post.frontmatter.title}</h2>
            <p>{post.frontmatter.description}</p>
            <span class="date">{post.frontmatter.date}</span>
          </a>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background-color: #F1E8C7; color: #2d2d2d; font-family: 'Inter', sans-serif; }
  nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 3rem; border-bottom: 1px solid #9CA76440; }
  .logo { font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 700; color: #9CA764; text-decoration: none; }
  .nav-links a { margin-left: 2rem; text-decoration: none; color: #2d2d2d; font-size: 0.95rem; }
  .nav-links a:hover { color: #9CA764; }
  .blog-list { max-width: 700px; margin: 6rem auto; padding: 0 2rem; }
  h1 { font-family: 'Playfair Display', serif; font-size: 3rem; margin-bottom: 3rem; }
  .post-card { display: block; text-decoration: none; color: inherit; padding: 2rem; border: 1px solid #9CA76440; border-radius: 12px; margin-bottom: 1.5rem; transition: border-color 0.2s; }
  .post-card:hover { border-color: #9CA764; }
  .tag { font-size: 0.75rem; color: #9CA764; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
  .post-card h2 { font-family: 'Playfair Display', serif; font-size: 1.5rem; margin: 0.5rem 0; }
  .post-card p { font-size: 0.95rem; color: #555; line-height: 1.6; margin-bottom: 1rem; }
  .date { font-size: 0.8rem; color: #999; }
</style>